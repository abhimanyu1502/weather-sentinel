# ==============================================================================
# StormSentinel / AntiGravity — Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment
# ==============================================================================

# --- Application Core ---
APP_NAME=AntiGravity
APP_VERSION=3.0.0
DEBUG=False
DEMO_MODE=True
LOG_LEVEL=INFO

# --- Backend Host & Port ---
API_HOST=0.0.0.0
API_PORT=8000
DEMO_BROADCAST_INTERVAL_SEC=3

# --- Database & Cache Configuration ---
# Local Docker Compose defaults:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stormsentinel
POSTGRES_USER=weather_admin
POSTGRES_PASSWORD=stormsentinel_secure_2024
DATABASE_URL=postgresql://weather_admin:stormsentinel_secure_2024@localhost:5432/stormsentinel

# Redis (in-memory pub/sub and high-speed feature caching)
REDIS_URL=redis://localhost:6379/0

# --- Deep Learning Inference ---
# Device: 'cpu', 'cuda', or 'mps'
INFERENCE_DEVICE=cpu
MODEL_CHECKPOINT_PATH=models/checkpoints/convlstm_nowcaster.pt

# --- Subcontinent Spatial Domain (Pan-India) ---
DOMAIN_MIN_LAT=6.0
DOMAIN_MAX_LAT=37.5
DOMAIN_MIN_LON=68.0
DOMAIN_MAX_LON=97.5
GRID_RESOLUTION_KM=1.0
GRID_H=128
GRID_W=128

# --- Severe Weather Physics Parameters & Thresholds ---
# Convective Initiation Cloud-Top Cooling Rate (Kelvin / 15 min)
CI_DETECTION_COOLING_RATE_K=-4.0
# Cloudburst Rain Rate Threshold (Marshall-Palmer Z-R) in mm/hr
CLOUDBURST_RAIN_RATE_MM_HR=100.0
# Downburst Radial Velocity Divergence in m/s (~55+ km/h gust)
DOWNBURST_DIVERGENCE_MS=25.0
# Severe Hail Maximum Expected Size of Hail (MESH) in mm
HAIL_MESH_SEVERE_MM=25.0
# Reflectivity Storm Identification Threshold (dBZ)
REFLECTIVITY_STORM_THRESHOLD_DBZ=38.0
MIN_STORM_AREA_KM2=12.0

# --- Optional AI Meteorological Advisory Services (LLMs) ---
# Add your keys for LLM-powered multilingual meteorological bulletins
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# --- Frontend Environment Variables (Vite) ---
# For local development:
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
# For production cloud deployment (example):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_WS_BASE_URL=wss://api.yourdomain.com
